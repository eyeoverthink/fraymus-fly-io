# Everything is optional: with no keys the app runs locally with mocks, sharp upscaling and SQLite.
GROQ_API_KEY=
HF_TOKEN=
REPLICATE_API_TOKEN=            # optional, and not used unless an opt-in below is also set

# Server: PORT (default 3001) and HOST (default 0.0.0.0). docker compose: HOST_PORT / HOST_BIND pick the host side.
PORT=3001
HOST=
HOST_PORT=
HOST_BIND=

# Persistence: SQLite in DATA_DIR by default; set both to use Supabase (run supabase/schema.sql first)
DATA_DIR=./data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth (Clerk). When CLERK_SECRET_KEY is set every /api route needs a signed-in user.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Without Clerk: shared-secret workspace gate. Sign in once at /login, or send Authorization: Bearer <token>.
# If neither Clerk nor this is set, /api/* fails closed (401). Local dev only: WORKSPACE_AUTH=off
WORKSPACE_ACCESS_TOKEN=
WORKSPACE_AUTH=

# Billing (Stripe metered usage)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=
FREE_CREDITS=0                  # credits for new accounts; paid Shopify packs are the product

PUBLIC_URL=                     # e.g. https://yourapp.fly.dev (used in the deploy curl)
CORS_ORIGIN=                    # comma-separated; default allows all

# Agents. Default chat is xAI (https://api.x.ai/v1), then Groq if GROQ_API_KEY is set.
# "none" forces the offline mock. Add ollama to use OLLAMA_HOST. Add openai only to call OpenAI.
LLM_PROVIDERS=xai,groq
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASIC_AUTH=              # user:pass if your VPS proxy requires it
OLLAMA_MODEL=                   # default: first model reported by /api/tags
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
SEARXNG_URL=                    # optional; web_search falls back to DuckDuckGo
ALLOW_PRIVATE_FETCH=            # set 1 to let http_get reach private/LAN addresses
HTTP_TOOLS_FILE=                # default config/http-tools.json
FRAYNIX_ENGINE_URL=
FRAYNIX_ENGINE_TOKEN=
HERMES_URL=
HERMES_TOKEN=
TTS_URL=

# --- Media skills (all optional; see README 'Media skills') ---
VOICESTUDIO_MCP_URL=           # e.g. http://127.0.0.1:3900/mcp/ (VoiceStudio, AGPL-3.0)
PHOTOCRAFT_CLI=                # absolute path to photocraft-cli binary (runs 'photocraft-cli mcp')
REA_MCP=                       # set to 1 to enable Reverse Engineer Anything MCP via npx
MCP_SERVERS_FILE=              # override ./config/mcp-servers.json

# --- Agent hub ---
MCP_ADMIN_TOKEN=               # 24+ chars: static full-admin bearer for /mcp (headless VPS use)
ALLOW_STDIO_IMPORT=            # set 1 to let the UI/MCP import local-command MCP servers (runs code on this host)
AGENTS_DIR=                    # default ./agents

# Set to off to disable the cron scheduler
# SCHEDULER=off

# Stage 1 organism candidates. Both stay off unless set to on, 1, or true. Any other value, including empty, is off.
ORGANISM_TELEMETRY=             # on = Agents tab shows a read-only simulated 16x8 sheet plus live agent/status counts. Not a success score.
MEMORY_NGRAM=                   # on = blend the hashed character n-gram candidate into memory search. FTS and embeddings stay in place.

# --- Shopify credit fulfillment (hosting option B: Fly.io, SQLite on a volume) ---
SHOPIFY_WEBHOOK_SECRET=         # HMAC key: the secret shown under Settings > Notifications > Webhooks (admin-created webhooks) OR the custom app's client secret (API-created)
SHOPIFY_SHOP_DOMAIN=eyeoverthink.myshopify.com
SHOPIFY_PACK_PRODUCT_ID=8843401527492   # comma-separate to sell more packs
SHOPIFY_CREDITS_PER_PACK=25
# Buyer page (/enhance): email one-time code via Resend
RESEND_API_KEY=
MAIL_FROM=                      # e.g. "FRAYMUS <codes@yourdomain.com>" on a domain verified in Resend
BUYER_PIPELINE_STRICT=1         # 1 = paid runs fail (and refund) instead of returning placeholders
BUYER_CODE_DEV_ECHO=            # 1 = return the code in the API response (tests only; ignored when NODE_ENV=production)
# Sharp Lanczos is a resize, not AI upscaling. A missing Replicate upscale does not fail a paid image run.
ENABLE_PAID_REPLICATE=          # 1, plus IMAGE_PROVIDERS listing replicate, plus REPLICATE_API_TOKEN, calls Real-ESRGAN. Off by default.
# Prompt step. On Fly this is xAI: PROMPT_LLM_BASE_URL=https://api.x.ai/v1 and PROMPT_LLM_API_KEY.
# OPENAI_BASE_URL / OPENAI_API_KEY are used here only when LLM_PROVIDERS lists openai and the prompt URL is unset.
PROMPT_LLM=                     # groq|openai|xai|template. openai + an x.ai base URL is the xAI prompt step.
PROMPT_LLM_BASE_URL=            # https://api.x.ai/v1
PROMPT_LLM_API_KEY=             # xAI key. Also used by agent chat when the base URL is api.x.ai.
PROMPT_LLM_MODEL=               # e.g. grok-4.20-0309-non-reasoning
XAI_API_KEY=                    # optional override for chat; otherwise PROMPT_LLM_API_KEY is reused
XAI_MODEL=                      # optional override; otherwise PROMPT_LLM_MODEL
OPENAI_USER_AGENT=              # sent only on an explicit OpenAI call
# Image generation goes through runFlux. Unset IMAGE_PROVIDERS uses huggingface,gemini,pollinations,local.
# A name is skipped until its setting is present, except pollinations (no key).
# IMAGE_PROVIDERS=none returns an offline placeholder and makes no image request.
# If every provider that was called fails, the error names each one and why.
# OpenAI and Replicate bill per image. They run only when listed here AND their key is set.
# OpenAI image calls go to api.openai.com (or OPENAI_IMAGE_BASE_URL), never OPENAI_BASE_URL, so an xAI chat setup is not an image call.
# Do not put confidential text in prompts: Pollinations may cache the URL and show it to others.
# IMAGE_PROVIDERS=huggingface,gemini,pollinations,local
BUYER_IMAGE_PROVIDERS=huggingface   # paid /enhance runs. Fail and refund instead of a watermark or a placeholder.
HF_IMAGE_MODEL=                 # one model id. Unset tries FLUX.1-schnell, then SDXL.
HF_IMAGE_MODELS=                # default black-forest-labs/FLUX.1-schnell,stabilityai/stable-diffusion-xl-base-1.0
IMAGE_GENERATION_TIMEOUT_MS=120000
IMAGE_DOWNLOAD_MAX_BYTES=25000000
# Gemini image (gemini-2.5-flash-image). Called only when GEMINI_API_KEY (below) is set.
# Google's pricing page lists no free tier for that model, so a key can bill per image. Leave it blank to stay no-cost.
GEMINI_IMAGE_MODEL=
# Local server. LOCAL_IMAGE_KIND: a1111 (default), comfy, openai/ollama (local /v1/images/generations, not api.openai.com), json.
LOCAL_IMAGE_URL=
LOCAL_IMAGE_KIND=
LOCAL_IMAGE_TOKEN=
COMFY_CHECKPOINT=
# Paid image opt-in. Ignored unless IMAGE_PROVIDERS includes the name.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# Embeddings stay on keyword search unless EMBED_BASE_URL and EMBED_API_KEY are set.
# EMBED_ALLOW_OPENAI=1 is required before embeddings reuse OPENAI_BASE_URL / OPENAI_API_KEY.
EMBED_ALLOW_OPENAI=

# --- Story Shorts (server/shorts) ---
# The Docker image sets PIPER_BIN/PIPER_MODEL itself. For `npm start` install ffmpeg + espeak-ng, and optionally Piper:
PIPER_BIN=                     # path to the piper binary (default: piper on PATH)
PIPER_MODEL=                   # path to a .onnx voice with its .onnx.json next to it; unset = espeak-ng voice
PIPER_LENGTH_SCALE=
PIPER_SENTENCE_SILENCE=
ESPEAK_BIN=
ESPEAK_VOICE=
ESPEAK_WPM=
FFMPEG_BIN=
FFPROBE_BIN=
SHORTS_MAX_CONCURRENT=
SHORTS_FFMPEG_THREADS=

# --- FRAYMUS Logic Chain (server/logic-chain + vendor/logic-chain, see docs/LOGIC-CHAIN.md) ---
# Runs are MOCK (demo fixtures, no network, no cost) unless a request sets mode "live" AND approveSpend: true (owner only).
LOGIC_CHAIN=                   # off = don't start the sidecar (the routes then answer 503)
LOGIC_CHAIN_PROVIDERS=         # live seats, in order; default xai,gemini (add openai to opt in; only those with a key are used)
XAI_API_KEY=                   # xAI (Grok); unset = PROMPT_LLM_API_KEY when PROMPT_LLM_BASE_URL is https://api.x.ai/v1
GEMINI_API_KEY=                # Google Gemini
# OPENAI_API_KEY / OPENAI_BASE_URL above are reused for the OpenAI seat (OPENAI_BASE_URL set = OpenAI-compatible router)
LOGIC_CHAIN_XAI_MODEL=         # default grok-4.3
LOGIC_CHAIN_GEMINI_MODEL=      # default gemini-3.5-flash-lite
LOGIC_CHAIN_OPENAI_MODEL=      # default OPENAI_MODEL, else gpt-4.1-mini
LOGIC_CHAIN_MAX_RUN_CENTS=     # per-run cost cap in cents, default 100 ($1.00); a request can lower it, never raise it
LOGIC_CHAIN_MAX_PLAN_CALLS=    # per-run model-call cap, default 60
LOGIC_CHAIN_MAX_SECONDS=       # per-run wall-clock cap, default 3600
# Signing identity (Ed25519). Neither set = a LOCAL KEY auto-generated in DATA_DIR/logic-chain/identity, labelled as such.
FRAYMUS_IDENTITY_FILE=         # path to an existing 32-byte seed file (hex); a missing path is refused, never replaced
FRAYMUS_IDENTITY_SEED=         # or the 64-hex seed itself, as a secret (fly secrets set FRAYMUS_IDENTITY_SEED=...)
LOGIC_CHAIN_PYTHON=            # default python3 (3.10+)
LOGIC_CHAIN_DIR=               # default ./vendor/logic-chain
LOGIC_CHAIN_PORT=              # default: a free loopback port
LOGIC_CHAIN_URL=               # use an already-running Logic Chain on loopback instead of starting one (needs FRAYMUS_SERVER_TOKEN)
LOGIC_CHAIN_OLLAMA_URL=        # default OLLAMA_HOST or http://127.0.0.1:11434 (not used by the default seats)
LOGIC_CHAIN_TOOL_WAIT_MS=      # how long the logic_chain_run agent tool waits, default 600000

# --- PC worker (scripts/shorts-pc-worker.py, runs on your PC, not on the server) ---
# FRAYMUS_URL=http://localhost:3001     # or https://fraymus-fly-io.fly.dev
# FRAYMUS_TOKEN_FILE=C:\path\token.txt  # file holding WORKSPACE_ACCESS_TOKEN (or FRAYMUS_TOKEN)
# VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_PROFILE=vaughn-one
