# Optional. Copy to .env, which stays out of git. Never expose these in browser code.
# Memberships (Claude, ChatGPT, Ollama Cloud) and GitHub need no key here: sign in with their own tools.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Optional GitHub Models token; otherwise your gh login is used:
GITHUB_MODELS_KEY=
# Optional API authentication for this local server:
FRAYMUS_SERVER_TOKEN=
# Optional: port, and a separate folder for runs, skills and provider settings:
FRAYMUS_PORT=8765
FRAYMUS_DATA_DIR=
# Optional: listen address (the Docker image sets 0.0.0.0; compose still publishes on 127.0.0.1 only):
FRAYMUS_HOST=
# Optional: Ollama address, e.g. http://host.docker.internal:11434 from inside Docker:
FRAYMUS_OLLAMA_URL=
# Optional: extra comma-separated host names treated as local (no remote consent prompt):
FRAYMUS_LOCAL_HOSTS=
# Optional: Ed25519 seed file (64 hex chars) that signs every stage. Point this at your own Fraymus identity
# to sign as your fx number. If unset, one is created under FRAYMUS_DATA_DIR/identity with mode 0600:
FRAYMUS_IDENTITY_FILE=
